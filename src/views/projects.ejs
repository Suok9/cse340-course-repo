<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <% if (projects.length > 0) { %>
        <ul class="project-list">
            <% projects.forEach((project) => { %>
                <li class="project-tile">
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= project.title %></strong>
                    </a>
                    <p>
                        Partner organization:
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </p>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects are currently available.</p>
    <% } %>
</main>

<%- include('partials/footer') %>